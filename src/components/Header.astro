---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav aria-label="Primary navigation">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="brand-mark" aria-hidden="true">HW</span>
			<span class="brand-name">{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Investigations</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1.5rem;
		background: rgba(255, 253, 248, 0.96);
		border-bottom: 1px solid rgba(72, 35, 108, 0.14);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(1180px, 100%);
		min-height: 76px;
		margin: 0 auto;
	}
	.brand {
		display: inline-flex;
		gap: 0.75rem;
		align-items: center;
		color: #281638;
		text-decoration: none;
	}
	.brand-mark {
		display: grid;
		width: 42px;
		height: 42px;
		place-items: center;
		background: #48236c;
		color: #fffdf8;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}
	.brand-name {
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}
	.internal-links {
		display: flex;
		gap: clamp(0.6rem, 2vw, 1.6rem);
		align-items: center;
	}
	.internal-links :global(a) {
		padding: 0.55rem 0;
		border-bottom: 2px solid transparent;
		color: #281638;
		font-size: 0.83rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.internal-links :global(a:hover),
	.internal-links :global(a:focus-visible),
	.internal-links :global(a.active) {
		border-bottom-color: #c94c16;
		color: #c94c16;
		text-decoration: none;
	}
	@media (max-width: 680px) {
		header {
			padding: 0 1rem;
		}
		nav {
			min-height: 66px;
		}
		.brand-mark {
			width: 38px;
			height: 38px;
		}
		.brand-name {
			display: none;
		}
		.internal-links {
			gap: 0.8rem;
		}
		.internal-links :global(a) {
			font-size: 0.72rem;
		}
	}
</style>
