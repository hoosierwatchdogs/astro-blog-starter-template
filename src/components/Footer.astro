---
import { CONTACT_EMAIL, SITE_TITLE } from '../consts';

const today = new Date();
const tipMailto = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('Confidential tip for Hoosier Watchdogs')}`;
---

<footer>
	<div class="footer-inner">
		<div>
			<a class="footer-brand" href="/">{SITE_TITLE}</a>
			<p>Holding power accountable across Indiana.</p>
		</div>
		<div class="footer-links">
			<a href="/blog">Investigations</a>
			<a href="/about">About</a>
			<a href={tipMailto}>Share a tip</a>
		</div>
	</div>
	<p class="copyright">&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
</footer>
<style>
	footer {
		padding: 3.5rem max(1.5rem, calc((100% - 1180px) / 2)) 2rem;
		background: #281638;
		color: rgba(255, 253, 248, 0.72);
	}
	.footer-inner {
		display: flex;
		gap: 2rem;
		align-items: flex-start;
		justify-content: space-between;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid rgba(255, 253, 248, 0.16);
	}
	.footer-brand {
		color: #fffdf8;
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
	}
	footer p {
		margin: 0.55rem 0 0;
		font-size: 0.9rem;
	}
	.footer-links {
		display: flex;
		gap: 1.4rem;
		flex-wrap: wrap;
	}
	.footer-links a {
		color: #fffdf8;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}
	.footer-links a:hover,
	.footer-links a:focus-visible {
		color: #e76228;
	}
	.copyright {
		font-size: 0.76rem;
		letter-spacing: 0.04em;
	}
	@media (max-width: 650px) {
		.footer-inner {
			flex-direction: column;
		}
	}
</style>
